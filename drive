package org.firstinspires.ftc.teamcode;
import com.bylazar.telemetry.PanelsTelemetry;
import com.bylazar.telemetry.TelemetryManager;
import com.qualcomm.robotcore.eventloop.opmode.Disabled;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.robotcore.util.ElapsedTime;




import org.firstinspires.ftc.robotcontroller.external.samples.BasicOpMode_Iterative;
import org.firstinspires.ftc.robotcore.external.hardware.camera.BuiltinCameraDirection;
import org.firstinspires.ftc.robotcore.external.hardware.camera.WebcamName;
import org.firstinspires.ftc.vision.VisionPortal;
import org.firstinspires.ftc.vision.apriltag.AprilTagDetection;
import org.firstinspires.ftc.vision.apriltag.AprilTagProcessor;


import java.util.List;


@TeleOp(name = "2025")
public class drive extends LinearOpMode {
   private DcMotor rightFront = null;
   private DcMotor leftFront = null;
   private DcMotor rightBack = null;
   private DcMotor leftBack = null;


   private DcMotor takeout1 = null;
   private DcMotor takeout2 = null;
   private DcMotor takein = null;


   private TelemetryManager panelsTelemetry;


   private double[] apriltagData = {-1};
   private boolean reset = false;




   private static final boolean USE_WEBCAM = true;
   private AprilTagProcessor aprilTag;
   private VisionPortal visionPortal;


   private ElapsedTime runtime = new ElapsedTime();




   @Override
   public void runOpMode() throws InterruptedException {
       rightFront = hardwareMap.dcMotor.get("fr");
       rightBack = hardwareMap.dcMotor.get("br");
       leftFront = hardwareMap.dcMotor.get("fl");
       leftBack = hardwareMap.dcMotor.get("bl");
       takeout1= hardwareMap.dcMotor.get("f1");
       takeout2= hardwareMap.dcMotor.get("f2");
       takein = hardwareMap.dcMotor.get("i");


       rightFront.setDirection(DcMotor.Direction.REVERSE);
       rightBack.setDirection(DcMotor.Direction.REVERSE);


       takein.setDirection(DcMotor.Direction.REVERSE);


       initAprilTag();
       panelsTelemetry = PanelsTelemetry.INSTANCE.getTelemetry();


       waitForStart();




       while (opModeIsActive()) {


           apriltagData = telemetryAprilTag();


           double ID = apriltagData[0];
           double r = apriltagData[1];
           double b = apriltagData[2]; //correction of ~3 degrees to account for the camera offset




           if ((gamepad1.left_stick_x == 0) && (gamepad1.right_stick_y == 0) && (!gamepad2.a)) {
               leftFront.setPower(0);
               leftBack.setPower(0);
               rightFront.setPower(0);
               rightBack.setPower(0);
           }




           //forward/backwards
           if (gamepad1.right_stick_y != 0) {
               double power = gamepad1.right_stick_y;
               leftFront.setPower(0.8 * power);
               leftBack.setPower(0.8 * power);
               rightFront.setPower(0.8 * power);
               rightBack.setPower(0.8 * power);




               telemetry.addData("right stick y ", "value" + gamepad1.right_stick_y);
           }


           if (gamepad1.left_bumper) {
               leftFront.setPower(-0.67);
               leftBack.setPower(0.67);
               rightFront.setPower(0.67);
               rightBack.setPower(-0.67);




               telemetry.addLine("shuffle left");
           }


           if (gamepad1.right_bumper) {
               leftFront.setPower(0.67);
               leftBack.setPower(-0.67);
               rightFront.setPower(-0.67);
               rightBack.setPower(0.67);




               telemetry.addLine("shuffle right");
           }




           //turn
           if (gamepad1.left_stick_x != 0) {
               double power = gamepad1.left_stick_x;
               leftFront.setPower(-0.8 * power);
               leftBack.setPower(-0.8 * power);
               rightFront.setPower(0.8 * power);
               rightBack.setPower(0.8 * power);
               telemetry.addData("right stick x ", "value" + gamepad1.left_stick_x);




           }




           if ((gamepad2.left_stick_y == 0) && (gamepad2.left_trigger == 0) && (gamepad2.right_trigger == 0) && (!gamepad2.right_bumper) && (!gamepad2.left_bumper) && !gamepad2.a) {
               takein.setPower(0);
               takeout1.setPower(0);
               takeout2.setPower(0);
           }




           //intake
           if (gamepad2.left_stick_y != 0) {
               takein.setPower(gamepad2.left_stick_y);
               telemetry.addData("intake:", gamepad2.left_stick_y);
           }




           //launch
           if (gamepad2.right_stick_y != 0) {
               takeout1.setPower(gamepad2.right_stick_y);
               takeout2.setPower(gamepad2.right_stick_y);
               telemetry.addData("outtake:", gamepad2.right_stick_y);
           }


           telemetry.addLine("Gamepad 2: Hold A to launch!");
           telemetry.update();
           //automated launch
           if (gamepad2.a) {


               //rotate so within a 4 degree range of apriltag
               if (b != -10000 &&  b < -2) {
                   leftFront.setPower(-0.15);
                   leftBack.setPower(-0.15);
                   rightFront.setPower(0.15);
                   rightBack.setPower(0.15);
                   resetRuntime();
               } else if (b != -10000 && b > 2) {
                   leftFront.setPower(0.15);
                   leftBack.setPower(0.15);
                   rightFront.setPower(-0.15);
                   rightBack.setPower(-0.15);
                   resetRuntime();
               } else {
                   leftFront.setPower(0);
                   leftBack.setPower(0);
                   rightFront.setPower(0);
                   rightBack.setPower(0);
               }


               //when facing apriltag head on
               if (b > -2 && b < 2) {
                   if (!reset) {
                       resetRuntime();
                       reset = true;
                   }
                   /** I don't know what I'm doing. Distance from apriltag divided by 200 (presumably the furthest the robot will ever be from the goal).
                    Then raised to the power of 1/10 ish to make it like logarithmic-ish. idk put it in desmos **/
                   double power = Math.min(Math.pow(((r+5)/190), 0.1), 1);
                   telemetry.addData("launch power: ", power);
                   telemetry.update();
                   takeout1.setPower(power);
                   takeout2.setPower(power);
                   if (runtime.seconds() > 10) {
                       takein.setPower(1);
                   }
               } else {
                   reset = false;
               }
           }




       }








   }




   private void initAprilTag() {
       aprilTag = AprilTagProcessor.easyCreateWithDefaults();
       if (USE_WEBCAM) {
           visionPortal = VisionPortal.easyCreateWithDefaults(
                   hardwareMap.get(WebcamName.class, "Webcam 1"), aprilTag);
       } else {
           visionPortal = VisionPortal.easyCreateWithDefaults(
                   BuiltinCameraDirection.BACK, aprilTag);
       }
   }




   private double[] telemetryAprilTag() {
       double ID = -1;
       double r = -1;
       double b = -10000;
       double e = -1;
       List<AprilTagDetection> currentDetections = aprilTag.getDetections();
       telemetry.addData("# AprilTags Detected", currentDetections.size());


       for (AprilTagDetection detection : currentDetections) {
           if (detection.metadata != null) {
               ID = detection.id;
               r = detection.ftcPose.range; //inch
               b = detection.ftcPose.bearing; //deg
               e = detection.ftcPose.elevation; //deg


               telemetry.addData("AprilTag ID: ", ID);
               telemetry.addData("dist (inches) from apriltag: ", r);
               telemetry.addData("degrees from apriltag: ", b);


               break;
           }
       }
       return new double[]{ID, r, b, e};
   }




}









